DASHSCOPE_API_KEY=

OPENMUSE_MODEL=qwen3.7-plus
# OPENMUSE_MODEL_API=compatible
OPENMUSE_THINKING=off

OPENMUSE_TIMEZONE=Asia/Shanghai

# OPENMUSE_NODE=local
OPENMUSE_DEVICE_WORKSPACE=~/OpenMuse/workspace

OPENMUSE_SANDBOX_NETWORK=pypi.org,files.pythonhosted.org
